# ============================================================
#  CRÉA-ACTION — Configuration des clés API
#  Copiez ce fichier en .env et remplissez vos valeurs
# ============================================================

# --- Application ---
APP_URL=http://localhost:8000
SECRET_KEY=changez_moi_par_une_chaine_aleatoire_longue

# --- IA — Anthropic (Claude) ---
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- YouTube / Google OAuth 2.0 ---
# https://console.cloud.google.com — YouTube Data API v3 + Analytics
# Redirect URI: http://localhost:8000/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta (Instagram + Facebook) ---
# https://developers.facebook.com
# Redirect URI: http://localhost:8000/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# --- TikTok ---
# https://developers.tiktok.com
# Redirect URI: http://localhost:8000/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Snapchat ---
# https://kit.snapchat.com/manage
# Redirect URI: http://localhost:8000/auth/snapchat/callback
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# --- Pinterest ---
# https://developers.pinterest.com/apps/
# Redirect URI: http://localhost:8000/auth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Twitch ---
# https://dev.twitch.tv/console
# Redirect URI: http://localhost:8000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Twitter / X ---
# https://developer.twitter.com/en/portal/dashboard
# Redirect URI: http://localhost:8000/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn ---
# https://www.linkedin.com/developers/apps
# Redirect URI: http://localhost:8000/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Spotify ---
# https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:8000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Patreon ---
# https://www.patreon.com/portal/registration/register-clients
# Redirect URI: http://localhost:8000/auth/patreon/callback
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# --- Gumroad ---
# https://app.gumroad.com/settings/advanced
GUMROAD_API_KEY=

# --- Lemon Squeezy ---
# https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
